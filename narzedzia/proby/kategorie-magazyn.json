{
  "nazwa": "kategorie-magazyn",
  "modul": "Magazyn (pro)",
  "opis": "Kategorie po redesignie: drzewo z licznikiem, rozwiń/zwiń, szukanie bez ogonków z przodkami, dialog „Wybierz miejsce” (anuluj/Escape/wybierz), dodanie główne i podkategoria (rap_saveCategory), menu ⋯: zmiana nazwy, przeniesienie, usunięcie (rap_editCategory / rap_deleteCategory) — zapisy przechwycone",
  "sekcja": "rap_categories",
  "korzen": "#rap_categories",
  "przechwyc": ["rap_saveCategory", "rap_editCategory", "rap_deleteCategory"],
  "opoznienieAtrapy": 400,
  "kroki": [
    { "viewport": [1440, 900] },
    { "czekaj": 1500 },
    { "js": "JSON.stringify({licznik: document.getElementById('rap_kat-licznik').textContent, wezlow: document.querySelectorAll('#rap_tree-container .kat-wezel').length, korzeni: document.querySelectorAll('#rap_tree-container > .kat-galaz > .kat-wezel').length, otwartychKorzeni: document.querySelectorAll('#rap_tree-container > .kat-galaz > .kat-wezel.kat-otwarte').length})", "opis": "KAT01: drzewo z danych" },
    { "sprawdz": "Number(document.getElementById('rap_kat-licznik').textContent) === document.querySelectorAll('#rap_tree-container .kat-wezel').length && document.querySelectorAll('#rap_tree-container .kat-wezel').length > 0", "opis": "KAT01: licznik = liczba wszystkich kategorii (niezależnie od rozwinięcia)" },
    { "zrzut": "01-desktop" },
    { "kliknij": "[data-kat-zwin]" }, { "czekaj": 200 },
    { "sprawdz": "document.querySelectorAll('#rap_tree-container .kat-wezel.kat-otwarte').length === 0 && Number(document.getElementById('rap_kat-licznik').textContent) === document.querySelectorAll('#rap_tree-container .kat-wezel').length", "opis": "Zwiń wszystko — licznik bez zmian" },
    { "kliknij": "[data-kat-rozwin]" }, { "czekaj": 200 },
    { "sprawdz": "document.querySelectorAll('#rap_tree-container .kat-ma-dzieci').length === document.querySelectorAll('#rap_tree-container .kat-ma-dzieci.kat-otwarte').length", "opis": "Rozwiń wszystko — wszystkie gałęzie otwarte" },
    { "wpisz": "[data-kat-szukaj]", "wartosc": "plyny" }, { "czekaj": 200 },
    { "js": "JSON.stringify({dopasowania: document.querySelector('[data-kat-dopasowania]').textContent, widoczne: [...document.querySelectorAll('#rap_tree-container .kat-wezel:not(.kat-ukryty)')].map(l => l.dataset.nazwa + (l.classList.contains('kat-dopasowany') ? ' *' : ' (przodek)'))})", "opis": "KAT13: szukanie „plyny” bez ogonków — dopasowania i przodkowie" },
    { "sprawdz": "[...document.querySelectorAll('#rap_tree-container .kat-wezel.kat-dopasowany')].length >= 1 && [...document.querySelectorAll('#rap_tree-container .kat-wezel.kat-dopasowany')].every(l => /płyny/i.test(l.dataset.sciezka)) && [...document.querySelectorAll('#rap_tree-container .kat-wezel.kat-przodek')].every(l => !l.classList.contains('kat-ukryty'))", "opis": "szukanie pokazuje dopasowania z przodkami" },
    { "zrzut": "02-szukanie" },
    { "wpisz": "[data-kat-szukaj]", "wartosc": "xyzxyz" }, { "czekaj": 200 },
    { "sprawdz": "/Brak dopasowań/.test(document.querySelector('[data-kat-dopasowania]').textContent) && document.querySelectorAll('#rap_tree-container .kat-wezel:not(.kat-ukryty)').length === 0", "opis": "KAT13: brak dopasowań — osobny komunikat, nie pusta baza" },
    { "wpisz": "[data-kat-szukaj]", "wartosc": "" }, { "czekaj": 200 },
    { "sprawdz": "document.querySelectorAll('#rap_tree-container .kat-wezel.kat-ukryty').length === 0", "opis": "po wyczyszczeniu filtra wszystko widoczne" },
    { "kliknij": "[data-kat-trigger]" }, { "czekaj": 300 },
    { "sprawdz": "document.querySelector('[data-kat-dialog]').open && document.querySelectorAll('[data-kat-opcje] .kat-opcja').length === document.getElementById('rap_c_parent').options.length && document.querySelector('[data-kat-opcje] .kat-opcja input').checked", "opis": "KAT06: dialog otwarty, opcje = select (+ Poziom główny zaznaczony)" },
    { "zrzut": "03-dialog-wyboru-miejsca" },
    { "js": "(function(){ const r=[...document.querySelectorAll('[data-kat-opcje] .kat-opcja input')].find(i => /Higieniczne/.test(i.closest('.kat-opcja').textContent)); r.click(); return r.value; })()", "opis": "roboczy wybór: Higieniczne (id)" },
    { "kliknij": "[data-kat-anuluj]" }, { "czekaj": 200 },
    { "sprawdz": "!document.querySelector('[data-kat-dialog]').open && document.getElementById('rap_c_parent').value === '' && document.querySelector('[data-kat-parent-tekst]').textContent === 'Poziom główny'", "opis": "KAT06: Anuluj — roboczy wybór odrzucony, select bez zmian" },
    { "kliknij": "[data-kat-trigger]" }, { "czekaj": 300 },
    { "wpisz": "[data-kat-dialog-szukaj]", "wartosc": "tygodniowa higien" }, { "czekaj": 200 },
    { "sprawdz": "document.querySelectorAll('[data-kat-opcje] .kat-opcja').length === 1 && /Higieniczne/.test(document.querySelector('[data-kat-opcje] .kat-opcja').textContent)", "opis": "filtr w dialogu bez ogonków → 1 opcja z pełną ścieżką" },
    { "kliknij": "[data-kat-opcje] .kat-opcja input" },
    { "kliknij": "[data-kat-wybierz]" }, { "czekaj": 200 },
    { "sprawdz": "!document.querySelector('[data-kat-dialog]').open && document.getElementById('rap_c_parent').value !== '' && /Higieniczne/.test(document.querySelector('[data-kat-parent-tekst]').textContent) && /podkategorią/.test(document.querySelector('[data-kat-parent-opis]').textContent)", "opis": "Wybierz miejsce — select ustawiony na id Higieniczne, opis zmieniony" },
    { "wpisz": "#rap_c_name", "wartosc": "Rękawiczki" },
    { "zrzut": "04-formularz-podkategoria" },
    { "kliknij": "#rap_cat-form button[type=submit]", "dwuklik": true }, { "czekaj": 900 },
    { "sprawdz": "window.__proba.posty.length === 1 && window.__proba.posty[0].action === 'rap_saveCategory' && window.__proba.posty[0].name === 'Rękawiczki' && window.__proba.posty[0].parentId === document.getElementById('rap_c_parent').value && window.__proba.posty[0].parentId !== ''", "opis": "KAT03/KAT04: podkategoria — 1 POST rap_saveCategory {name, parentId=id rodzica}; dwuklik = 1" },
    { "sprawdz": "document.getElementById('rap_c_name').value === '' && document.getElementById('rap_c_parent').value !== ''", "opis": "po zapisie: nazwa wyczyszczona, rodzic zachowany (jak dotąd)" },
    { "js": "window.__proba.posty = []; document.getElementById('rap_c_name').value=''; document.querySelector('#rap_cat-form button[type=submit]').click(); 'ok'" }, { "czekaj": 300 },
    { "sprawdz": "window.__proba.posty.length === 0", "opis": "KAT04: pusta nazwa — blokuje walidacja natywna, 0 POST" },
    { "js": "window.__proba.posty = []; var li=document.querySelector('#rap_tree-container .kat-wezel'); li.querySelector('[data-kat-menu]').click(); JSON.stringify({menuOtwarte: !li.querySelector('.kat-menu').hidden, akcje: [...li.querySelectorAll('.kat-akcja')].map(b => b.textContent)})", "opis": "menu ⋯ przy pierwszym wierszu" },
    { "zrzut": "05-menu-akcji" },
    { "js": "var org=window.prompt; window.__nazwaStara=document.querySelector('#rap_tree-container .kat-wezel').dataset.nazwa; window.prompt=()=>{ window.prompt=org; return window.__nazwaStara + ' 2'; }; document.querySelector('#rap_tree-container .kat-wezel .kat-akcja').click(); 'ok'" }, { "czekaj": 800 },
    { "sprawdz": "window.__proba.posty.length === 1 && window.__proba.posty[0].action === 'rap_editCategory' && window.__proba.posty[0].nazwa === window.__nazwaStara + ' 2' && !!window.__proba.posty[0].id", "opis": "KAT09: Zmień nazwę → rap_editCategory {id, nazwa} (prompt jak dotąd)" },
    { "js": "window.__proba.posty = []; var li=document.querySelector('#rap_tree-container .kat-wezel'); li.querySelector('[data-kat-menu]').click(); var org=window.prompt; window.prompt=()=>{ window.prompt=org; return '0'; }; li.querySelectorAll('.kat-akcja')[1].click(); 'ok'" }, { "czekaj": 800 },
    { "sprawdz": "window.__proba.posty.length === 1 && window.__proba.posty[0].action === 'rap_editCategory' && window.__proba.posty[0].parentId === '' && !!window.__proba.posty[0].id", "opis": "KAT08: Przenieś → rap_editCategory {id, parentId} (prompt numerowany jak dotąd; 0 = poziom główny)" },
    { "js": "window.__proba.posty = []; window.__proba.confirmy = []; var li=document.querySelector('#rap_tree-container .kat-wezel'); li.querySelector('[data-kat-menu]').click(); li.querySelector('.kat-akcja-usun').click(); 'ok'" }, { "czekaj": 800 },
    { "sprawdz": "window.__proba.confirmy.length === 1 && window.__proba.posty.length === 1 && window.__proba.posty[0].action === 'rap_deleteCategory' && !!window.__proba.posty[0].id", "opis": "KAT10: Usuń → confirm → rap_deleteCategory {id} (jak dotąd; backend blokuje niepuste)" },
    { "ciemny": true }, { "zrzut": "06-ciemny" }, { "ciemny": false },
    { "viewport": [800, 550] }, { "czekaj": 500 }, { "pomiar": true },
    { "viewport": [400, 844] }, { "czekaj": 600 }, { "zrzut": "07-telefon-400" }, { "pomiar": true },
    { "kliknij": "[data-kat-trigger]" }, { "czekaj": 300 }, { "zrzut": "08-telefon-dialog" },
    { "sprawdz": "(function(){ const r=document.querySelector('[data-kat-dialog]').getBoundingClientRect(); return r.right <= document.documentElement.clientWidth + 1 && r.left >= -1; })()", "opis": "KAT02: dialog mieści się na 400 px" },
    { "klawisz": "Escape" }, { "czekaj": 200 },
    { "sprawdz": "!document.querySelector('[data-kat-dialog]').open", "opis": "KAT06: Escape zamyka dialog bez zmiany" },
    { "viewport": [320, 568] }, { "czekaj": 600 }, { "pomiar": true },
    { "viewport": [400, 275, 2] }, { "czekaj": 600 }, { "pomiar": true, "opis": "800x550 przy zoomie 200%" }
  ]
}
