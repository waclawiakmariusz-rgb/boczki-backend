{
  "nazwa": "audyt-a-nazwy",
  "modul": "Administracja",
  "opis": "Audyt terminarza, paczka A: przycisk „Zmień” przy pracowniku, odmowa pustego pracownika i pustej usługi w przeglądarce (bez POST), komunikat błędu widoczny 15 s",
  "sekcja": "setup-pracownicy",
  "korzen": ".section.active",
  "przechwyc": ["add_sales_def", "edit_employee"],
  "opoznienieAtrapy": 300,
  "kroki": [
    { "viewport": [1440, 900] },
    { "czekaj": 1500 },
    { "zrzut": "01-pracownicy-przycisk-zmien" },
    { "sprawdz": "document.querySelectorAll('#pracownicy-list .emp-edit').length > 0", "opis": "każdy wiersz ma przycisk „Zmień”" },
    { "wpisz": "#def_prac", "wartosc": "   " },
    { "js": "document.querySelector('#setup-pracownicy form').requestSubmit(); 'wyslano'", "opis": "pusty pracownik — wysłanie formularza" },
    { "czekaj": 700 },
    { "zrzut": "02-pusty-pracownik-komunikat" },
    { "sprawdz": "window.__proba.posty.length === 0", "opis": "pusty pracownik nie poszedł na serwer" },
    { "sprawdz": "window.__proba.alerty.some(a => /imię i nazwisko pracownika/.test(a))", "opis": "komunikat o pustym pracowniku (narzędzie przechwytuje alert zamiast toastu)" },
    { "js": "pokazPowiadomienie('error', 'Wystąpił problem', 'Podaj nazwę usługi (kategorię) — pole jest puste. Usługa bez nazwy nie zostanie zapisana.'); 'toast'", "opis": "podgląd toastu błędu (15 s)" },
    { "czekaj": 400 },
    { "zrzut": "02b-toast-bledu" },
    { "sprawdz": "!!document.querySelector('#boczki-toasts .b-toast.b-error')", "opis": "toast błędu wyrenderowany" },
    { "pokaz": "setup-zabiegi", "czekajPo": 1200 },
    { "wybierz": "#def_kat_select", "wartosc": "NEW" },
    { "wpisz": "#def_kat_input", "wartosc": "  " },
    { "wpisz": "#def_war", "wartosc": "Twarz" },
    { "wpisz": "#def_cena", "wartosc": "100" },
    { "kliknij": "#btn-zabieg-submit" },
    { "czekaj": 700 },
    { "zrzut": "03-pusta-usluga-komunikat" },
    { "sprawdz": "window.__proba.posty.length === 0", "opis": "usługa bez nazwy nie poszła na serwer" },
    { "wpisz": "#def_kat_input", "wartosc": "Omega " },
    { "wpisz": "#def_cena", "wartosc": "" },
    { "kliknij": "#btn-zabieg-submit" },
    { "czekaj": 700 },
    { "sprawdz": "window.__proba.posty.length === 0", "opis": "usługa bez ceny nie poszła na serwer" },
    { "wpisz": "#def_cena", "wartosc": "320" },
    { "kliknij": "#btn-zabieg-submit" },
    { "czekaj": 900 },
    { "sprawdz": "window.__proba.posty.length === 1 && window.__proba.posty[0].kategoria === 'Omega' && window.__proba.posty[0].wariant === 'Twarz'", "opis": "poprawna usługa: kategoria bez spacji na końcu" },
    { "js": "JSON.stringify(window.__proba.posty[0])", "opis": "payload usługi" },
    { "sprawdz": "window.__proba.alerty.filter(a => /pole jest puste|bez ceny/.test(a)).length >= 3", "opis": "trzy odmowy z czytelnym powodem (pusty pracownik, pusta nazwa, brak ceny)" },
    { "js": "JSON.stringify(window.__proba.alerty)", "opis": "wszystkie komunikaty" },
    { "czekaj": 9500 },
    { "sprawdz": "!!document.querySelector('#boczki-toasts .b-toast.b-error')", "opis": "toast błędu nadal widoczny po ~10 s (wcześniej znikał po 7 s)" },
    { "zrzut": "04-toast-po-10s" }
  ]
}
