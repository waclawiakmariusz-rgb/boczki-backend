    { "zrzut": "07-link-wygenerowany" },
    { "js": "window.__probaTpayUrl = document.getElementById('zg-wynik-link').textContent.trim(); zg_zamknij(); 'ok'" },
    { "czekaj": 500 },
    { "js": "zg_zaladujListe(1); 'ok'" },
