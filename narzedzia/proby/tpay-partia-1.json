    { "zrzut": "08-lista-linkow-oczekuje" },

    { "js": "location.href = window.__probaTpayUrl; 'nawigacja'", "opis": "strona płatności klientki (publiczna)" },
    { "czekaj": 3000 },
    { "sprawdz": "document.getElementById('c-main').style.display !== 'none' && /150/.test(document.getElementById('m-kwota').textContent)", "opis": "strona płatności: kwota 150 zł" },
    { "zrzut": "09-strona-platnosci-regulamin" },
    { "wpisz": "#f-imie", "wartosc": "Próba Tpay" },
