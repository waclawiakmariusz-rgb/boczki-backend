# Szablon konfiguracji IZOLOWANEGO środowiska testowego (odbiór, testy automatyczne zapisujące dane).
# Skopiuj do `.env.test` (plik ignorowany przez git) i uzupełnij — SEKRETY TYLKO LOKALNIE / NA SERWERZE, NIGDY W REPO.
#
# Uruchomienie serwera na osobnej bazie i wolnym porcie (nie zatrzymuj działającego `node server.js` na 3000):
#   node -r dotenv/config server.js dotenv_config_path=.env.test
# (server.js woła dotenv.config() bez nadpisywania — wartości z .env.test mają pierwszeństwo)
#
# Jednorazowe zasilenie bazy testowej danymi salonu demo (źródło: baza z .env, cel: baza z .env.test; źródło tylko do odczytu):
#   node narzedzia/kopia-tenanta.js --tenant demo-estelio --dry-run      # tylko liczy wiersze, nic nie zapisuje
#   node narzedzia/kopia-tenanta.js --tenant demo-estelio                # kopiuje tabele i wiersze tego salonu
#
# WYMAGANIE IZOLACJI: DB_NAME musi być INNĄ bazą niż w .env (skrypt kopii odmawia pracy, gdy nazwy/hosty są identyczne),
# a DB_USER powinien mieć prawa zapisu wyłącznie do tej bazy testowej (osobny użytkownik MySQL w panelu Hostingera).

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
PORT=3999

# bezpieczeństwo sesji jak na produkcji (middleware blokuje żądania bez ważnej sesji)
ENFORCE_SESSION=true

# hasło panelu admina środowiska testowego — inne niż produkcyjne
ADMIN_TOKEN=

# integracja zakupów terminarza (T02/T03) — ZOSTAW PUSTE w tym wydaniu (etap odłożony)
TERMINARZ_ZAKUPY_TENANTS=

# pozostałe integracje w środowisku testowym wyłączone / atrapy (zostaw puste): Stripe, Fakturownia, SMTP, Booksy, VAPID
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_CENA_GROSZE=7900
STRIPE_NAZWA=Estelio TEST
FAKTUROWNIA_TOKEN=
FAKTUROWNIA_SUBDOMAIN=
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
APP_URL=http://localhost:3999
BOOKSY_IMAP_HOST=
BOOKSY_IMAP_USER=
BOOKSY_IMAP_PASS=
BOOKSY_TENANT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
MAGDA_HASLO=
